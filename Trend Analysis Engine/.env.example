# Copy to .env and fill in.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=fashionairre_trends

GEMINI_API_KEY=
NORMALIZE_MODEL=gemini-2.5-flash
NARRATE_MODEL=gemini-2.5-pro

# thresholds (see DESIGN.md §15)
CONFIDENCE_MIN=0.6
SIGNATURE_BREADTH_FLOOR=0.10
MOMENTUM_MIN=0.05
MIN_LOOKS_TO_RANK=3
PALETTE_K=6

LOG_LEVEL=INFO
