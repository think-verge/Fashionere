# Provider selection
# IMAGE_PROVIDER: mock | fal | replicate | gemini
# TEXT_PROVIDER:  mock | anthropic | openai | gemini
# TREND_PROVIDER: mock
IMAGE_PROVIDER=mock
TEXT_PROVIDER=mock
TREND_PROVIDER=mock

# Keys (only needed when not using mock)
FAL_KEY=
REPLICATE_API_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model overrides (optional)
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o
FAL_MODEL=fal-ai/flux-pro
REPLICATE_MODEL=black-forest-labs/flux-pro
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Storage (local = re-host images into STATIC_DIR and serve from PUBLIC_BASE_URL; none = keep provider URLs)
STORAGE=local
STATIC_DIR=./static
PUBLIC_BASE_URL=http://localhost:8000

# Data
DATA_DIR=./data

# Job store (memory | redis)
JOB_STORE=memory
REDIS_URL=redis://localhost:6379/0

STORAGE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_BUCKET=Image Tiles
MOODBOARDS_COLLECTION=moodboards
ELEMENTS_COLLECTION=elements
