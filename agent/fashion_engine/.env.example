# ---------------------------------------------------------------------------
# Fashion Intelligence Engine — environment template
# Copy this file to `.env` and fill in your own values. Do NOT commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# MongoDB connection string (Atlas or self-hosted).
# Replace <user>, <password>, <cluster> with your own; keep credentials out of git.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority&authSource=admin

# Database and collection names (safe defaults — override if yours differ)
MONGO_DATABASE_NAME=centoire
MONGO_TREND_RECORDS_COLLECTION=Trends_Vogue
