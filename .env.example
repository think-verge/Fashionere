# Copy to .env and fill in values

# Backend
PORT=8000
MONGODB_URI=mongodb://localhost:27017/centoire
JWT_SECRET=change-me-in-production
CLIENT_ORIGIN=http://localhost:5173
AGENT_URL=http://localhost:8001
NODE_ENV=development

# Agent
IMAGE_PROVIDER=mock
TEXT_PROVIDER=mock
TREND_PROVIDER=mock        # set to "mongo" to use live Atlas trends
MONGODB_DB=centoire        # Atlas database name (required when TREND_PROVIDER=mongo)
TRENDS_COLLECTION=trend_records
# FAL_KEY=
# REPLICATE_API_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
