{
  "openapi": "3.0.0",
  "info": {
    "title": "Centoire API",
    "version": "1.0.0",
    "description": "AI-powered fashion platform API"
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ]
      },
      "AuthCredentials": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SignupRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "_id",
          "userId",
          "name",
          "description",
          "tags",
          "createdAt",
          "updatedAt"
        ]
      },
      "LookSummary": {
        "type": "object",
        "properties": {
          "look_id": {
            "type": "string"
          },
          "brand": {
            "type": "string",
            "nullable": true
          },
          "collection_id": {
            "type": "string",
            "nullable": true
          },
          "runway_url": {
            "type": "string",
            "nullable": true
          },
          "num_garments": {
            "type": "number"
          },
          "has_flats": {
            "type": "boolean"
          }
        },
        "required": [
          "look_id",
          "brand",
          "collection_id",
          "runway_url",
          "num_garments",
          "has_flats"
        ]
      },
      "ColorSwatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "pantone": {
            "type": "string"
          },
          "hex": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "FabricElement": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "material": {
            "type": "string"
          },
          "weight": {
            "type": "string"
          },
          "finish": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "swatch_url": {
            "type": "string"
          }
        }
      },
      "PatternElement": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "motif": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "scale": {
            "type": "string"
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "swatch_url": {
            "type": "string"
          }
        }
      },
      "Garment": {
        "type": "object",
        "properties": {
          "garment_id": {
            "type": "string",
            "nullable": true
          },
          "piece": {
            "type": "string",
            "nullable": true
          },
          "colors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColorSwatch"
            }
          },
          "flat": {
            "type": "string",
            "nullable": true
          },
          "fabrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FabricElement"
            }
          },
          "patterns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PatternElement"
            }
          }
        },
        "required": [
          "garment_id",
          "piece",
          "colors",
          "flat",
          "fabrics",
          "patterns"
        ]
      },
      "LookDetail": {
        "type": "object",
        "properties": {
          "look_id": {
            "type": "string"
          },
          "brand": {
            "type": "string",
            "nullable": true
          },
          "collection_id": {
            "type": "string",
            "nullable": true
          },
          "runway_url": {
            "type": "string",
            "nullable": true
          },
          "silhouette": {
            "type": "string",
            "nullable": true
          },
          "whole_look_flat": {
            "type": "string",
            "nullable": true
          },
          "garments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Garment"
            }
          },
          "status": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "look_id",
          "brand",
          "collection_id",
          "runway_url",
          "silhouette",
          "whole_look_flat",
          "garments",
          "status"
        ]
      },
      "TrendSheetSummary": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string"
          },
          "brand_slug": {
            "type": "string"
          },
          "window_years": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "total_looks": {
            "type": "number"
          }
        },
        "required": [
          "brand",
          "brand_slug",
          "window_years",
          "total_looks"
        ]
      },
      "MomentumInfo": {
        "type": "object",
        "properties": {
          "yoy_delta": {
            "type": "number",
            "nullable": true
          },
          "kind": {
            "type": "string"
          },
          "trustworthy": {
            "type": "boolean"
          },
          "by_year": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "like_season": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "yoy_delta",
          "kind",
          "trustworthy",
          "by_year",
          "like_season"
        ]
      },
      "EvidenceRef": {
        "type": "object",
        "properties": {
          "collection_id": {
            "type": "string"
          },
          "look_number": {
            "type": "number"
          },
          "hex": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "collection_id",
          "look_number"
        ]
      },
      "RankedValue": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "share": {
            "type": "number"
          },
          "looks": {
            "type": "number"
          },
          "signature_score": {
            "type": "number",
            "nullable": true
          },
          "momentum": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MomentumInfo"
              },
              {
                "nullable": true
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceRef"
            }
          }
        },
        "required": [
          "value",
          "share",
          "looks",
          "evidence"
        ]
      },
      "PaletteSwatch": {
        "type": "object",
        "properties": {
          "hex": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "share": {
            "type": "number"
          },
          "pantone": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "hex",
          "family",
          "share"
        ]
      },
      "DimensionAggregate": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string"
          },
          "total_looks": {
            "type": "number"
          },
          "by_year": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "ranked": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RankedValue"
            }
          },
          "palette": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaletteSwatch"
            }
          },
          "omitted_count": {
            "type": "number"
          }
        },
        "required": [
          "dimension",
          "total_looks",
          "by_year",
          "ranked",
          "palette",
          "omitted_count"
        ]
      },
      "TrendReportSection": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "coined_name": {
            "type": "string"
          },
          "narrative": {
            "type": "string"
          },
          "designer_cue": {
            "type": "string"
          }
        },
        "required": [
          "dimension",
          "label",
          "coined_name",
          "narrative",
          "designer_cue"
        ]
      },
      "TrendReportPullQuote": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "attribution"
        ]
      },
      "TrendReport": {
        "type": "object",
        "properties": {
          "headline": {
            "type": "string"
          },
          "standfirst": {
            "type": "string"
          },
          "at_a_glance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrendReportSection"
            }
          },
          "pull_quote": {
            "$ref": "#/components/schemas/TrendReportPullQuote"
          },
          "rendered_html": {
            "type": "string"
          },
          "generated_at": {
            "type": "string"
          },
          "narrate_model": {
            "type": "string"
          }
        },
        "required": [
          "headline",
          "standfirst",
          "at_a_glance",
          "sections",
          "pull_quote",
          "rendered_html",
          "generated_at",
          "narrate_model"
        ]
      },
      "TrendSheet": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string"
          },
          "brand_slug": {
            "type": "string"
          },
          "report_type": {
            "type": "string"
          },
          "window_years": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "collections": {
            "type": "number"
          },
          "total_looks": {
            "type": "number"
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/DimensionAggregate"
            }
          },
          "generated": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            }
          },
          "report": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrendReport"
              },
              {
                "nullable": true
              }
            ]
          }
        },
        "required": [
          "brand",
          "brand_slug",
          "report_type",
          "window_years",
          "collections",
          "total_looks",
          "dimensions",
          "generated"
        ]
      },
      "CostInput": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "fabricType": {
            "type": "string"
          },
          "complexity": {
            "type": "string",
            "enum": [
              "simple",
              "moderate",
              "complex"
            ]
          },
          "market": {
            "type": "string",
            "enum": [
              "budget",
              "mid",
              "premium",
              "luxury"
            ]
          }
        },
        "required": [
          "category",
          "quantity",
          "fabricType",
          "complexity",
          "market"
        ]
      },
      "CostEstimate": {
        "type": "object",
        "properties": {
          "fabricCostPerUnit": {
            "type": "number"
          },
          "laborCostPerUnit": {
            "type": "number"
          },
          "overheadPerUnit": {
            "type": "number"
          },
          "totalPerUnit": {
            "type": "number"
          },
          "totalForQuantity": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "breakdown": {
            "type": "object",
            "properties": {
              "fabric": {
                "type": "number"
              },
              "labor": {
                "type": "number"
              },
              "overhead": {
                "type": "number"
              },
              "packaging": {
                "type": "number"
              }
            },
            "required": [
              "fabric",
              "labor",
              "overhead",
              "packaging"
            ]
          }
        },
        "required": [
          "fabricCostPerUnit",
          "laborCostPerUnit",
          "overheadPerUnit",
          "totalPerUnit",
          "totalForQuantity",
          "currency",
          "breakdown"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/auth/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCredentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me": {
      "patch": {
        "tags": [
          "Users"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/looks": {
      "get": {
        "tags": [
          "Looks"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "brand",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LookSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/looks/{lookId}": {
      "get": {
        "tags": [
          "Looks"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "lookId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LookDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trends": {
      "get": {
        "tags": [
          "Trends"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TrendSheetSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trends/{brandSlug}": {
      "get": {
        "tags": [
          "Trends"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "brandSlug",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrendSheet"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trends/generate/stream": {
      "post": {
        "tags": [
          "Trends"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "brand_slug": {
                    "type": "string"
                  }
                },
                "required": [
                  "brand_slug"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "NDJSON stream (application/x-ndjson) of stage/progress/done/error events — not representable as a single JSON body; consume via a raw fetch + ReadableStream reader, not the generated client."
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "tags": [
          "Projects"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Projects"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{id}": {
      "get": {
        "tags": [
          "Projects"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Projects"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Projects"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/cost/estimate": {
      "post": {
        "tags": [
          "Cost"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CostInput"
              }
            }
          }
