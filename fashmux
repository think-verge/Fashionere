#!/usr/bin/env bash
# tmux launcher for the Fashionare dev stack.
# Usage:
#   ./fashmux        start (or attach to) the dev session
#   ./fashmux kill   stop all services and tear down the session

cd "$(dirname "${BASH_SOURCE[0]}")" || exit 1

if ! command -v tmuxinator >/dev/null 2>&1; then
  echo "tmuxinator is not installed. Install it with: gem install tmuxinator" >&2
  exit 1
fi

if [[ "${1:-}" == "kill" || "${1:-}" == "stop" ]]; then
  tmux kill-session -t fashionare 2>/dev/null && echo "fashmux: session stopped." || echo "fashmux: no running session."
  exit 0
fi

if tmux has-session -t fashionare 2>/dev/null; then
  echo "fashmux: session already running, attaching..."
  if [ "$TERM_PROGRAM" == "iTerm.app" ]; then
    tmux -CC attach -t fashionare
  else
    tmux attach-session -t fashionare
  fi
  exit 0
fi

if [ "$TERM_PROGRAM" == "iTerm.app" ]; then
  tmuxinator start local -a false
  tmux -CC attach -t fashionare
else
  tmuxinator start local
fi
